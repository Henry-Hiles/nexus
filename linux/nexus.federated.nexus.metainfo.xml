<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>nexus.federated.nexus</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>

  <name>Nexus</name>
  <summary>A simple and user-friendly Matrix client</summary>
  <developer id="nexus.federated">
    <name>QuadRadical</name>
  </developer>

  <description>
    <p>
      Nexus is a simple and user-friendly client for Matrix, the open and
      decentralized chat network. It's made with Flutter, with gomuks handling
      the Matrix side.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Spaces, threads, replies and reactions</li>
      <li>End-to-end encryption, with verification and recovery keys</li>
      <li>Polls, location sharing, and custom emoji and sticker packs</li>
      <li>Multiple accounts</li>
      <li>Notifications through UnifiedPush</li>
      <li>Layouts for phones and desktops, including Linux phones</li>
    </ul>
  </description>

  <launchable type="desktop-id">nexus.federated.nexus.desktop</launchable>

  <url type="homepage">https://git.federated.nexus/Nexus/nexus</url>
  <url type="bugtracker">https://git.federated.nexus/Nexus/nexus/issues</url>
